# Paid study materials live here. A price on a link protects nothing, so this
# directory must never be reachable by URL — every download goes through
# material_download.php, which checks the payment before streaming the file.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
