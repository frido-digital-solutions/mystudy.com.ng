# ============================================================
# LOCAL CHECK SCAFFOLDING — throwaway probes and their screenshots.
# These are only ever for my own machine; they must never be pushed.
# ============================================================
_tmp_*
_shot_*
__pycache__/

# Whole-tree backups taken during the redesign passes. Local history only.
/_flat_backup/
/_strip_backup/
/_strip_list.txt
/_rooms_block.css
/_zzdl.bin

# ============================================================
# SERVER-ONLY SECRETS — must never reach GitHub
# ============================================================
config/secrets.local.php
config/vapid_keys.json
*.local.php

# ============================================================
# LIVE USER DATA — owned by the server, never by the repo.
# Contents are ignored, but each folder's .htaccess stays tracked
# so the deployed site still blocks direct access to these paths.
# ============================================================
/assets/uploads/*
!/assets/uploads/.htaccess

# Paid material files: server-owned, never pushed. The deny-all guard above
# them is tracked so the protection itself ships with the code.
/assets/secure/*
!/assets/secure/.htaccess

/uploads/*
!/uploads/.htaccess

/logs/*
!/logs/.htaccess

/cache/*
!/cache/.htaccess

# ============================================================
# Moved out of webroot: admin.zip + full SQL dump (password hashes)
# ============================================================
/_offwebroot/

# ============================================================
# SERVER-SPECIFIC PHP SETTINGS — differ per host
# ============================================================
/.user.ini
/php.ini

# ============================================================
# Backups, dumps and archives
# ============================================================
*.sql.gz
*.zip
*.tar
*.tar.gz
*.bak
*.old
*.orig

# ============================================================
# OS / editor noise
# ============================================================
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.idea/
.vscode/